  <profiles>
    <profile>
      <id>documentation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <inherited>true</inherited>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <additionalOptions>
                <additionalOption>--enable-preview</additionalOption>
              </additionalOptions>
              <source>${java.version}</source>
              <sourcepath>src/main/java</sourcepath>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <inherited>true</inherited>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>format</id>
      <properties>
        <checkstyle.failsOnError>true</checkstyle.failsOnError>
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <checkstyle.include.test.source>true</checkstyle.include.test.source>
        <checkstyle.include.test.resources>false</checkstyle.include.test.resources>
        <checkstyle.excludes>${project.build.directory}</checkstyle.excludes>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-checkstyle-config</id>
                <phase>process-sources</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>checkstyle.config.location</property>
                      <message>
                        Property 'checkstyle.config.location' must be set for this build!
                      </message>
                    </requireProperty>
                    <requireProperty>
                      <property>checkstyle.properties.location</property>
                      <message>
                        Property 'checkstyle.properties.location' must be set for this build!
                      </message>
                    </requireProperty>
                    <requireProperty>
                      <property>checkstyle.suppressions.location</property>
                      <message>
                        Property 'checkstyle.suppressions.location' must be set for this build!
                      </message>
                    </requireProperty>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <executions>
              <execution>
                <id>checkstyle</id>
                <phase>process-sources</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <consoleOutput>true</consoleOutput>
              <!--suppress MavenModelInspection -->
              <failsOnError>${checkstyle.failsOnError}</failsOnError>
              <!--suppress MavenModelInspection -->
              <failOnViolation>${checkstyle.failOnViolation}</failOnViolation>
              <propertyExpansion>
                project.groupId=${project.groupId}
              </propertyExpansion>
              <!--suppress UnresolvedMavenProperty -->
              <configLocation>${checkstyle.config.location}</configLocation>
              <!--suppress UnresolvedMavenProperty -->
              <propertiesLocation>${checkstyle.properties.location}</propertiesLocation>
              <!--suppress UnresolvedMavenProperty -->
              <suppressionsLocation>${checkstyle.suppressions.location}</suppressionsLocation>
              <!--suppress MavenModelInspection -->
              <excludes>${checkstyle.excludes}</excludes>
              <!--suppress MavenModelInspection -->
              <includeTestSourceDirectory>${checkstyle.include.test.source}</includeTestSourceDirectory>
              <!--suppress MavenModelInspection -->
              <includeTestResources>${checkstyle.include.test.resources}</includeTestResources>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>com.puppycrawl.tools</groupId>
                <artifactId>checkstyle</artifactId>
                <version>${checkstyle.version}</version>
              </dependency>
              <dependency>
                <groupId>io.spring.nohttp</groupId>
                <artifactId>nohttp-checkstyle</artifactId>
                <version>${nohttp.version}</version>
              </dependency>
              <dependency>
                <groupId>io.spring.javaformat</groupId>
                <artifactId>spring-javaformat-checkstyle</artifactId>
                <version>${spring-javaformat-checkstyle.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>execute-tests</id>
      <properties>
        <argLine>-Xmx2048m</argLine>
        <threadCount>10</threadCount>

        <surefire.argLine>-Xshare:off</surefire.argLine>
        <failsafe.argLine>-Xshare:off</failsafe.argLine>

        <maven.test.skip>false</maven.test.skip>

        <!-- Jacoco maven plugin configuration properties -->
        <jacoco.includes />
        <jacoco.excludes />

        <jacoco.report.title>${project.name}</jacoco.report.title>
        <jacoco.report.footer>${project.name}</jacoco.report.footer>
        <jacoco.report.formats>HTML</jacoco.report.formats>
        <jacoco.report.outputDirectory>${project.reporting.outputDirectory}/jacoco</jacoco.report.outputDirectory>

        <jacoco.rule.bundle.complexity.ratio>0.95</jacoco.rule.bundle.complexity.ratio>
        <jacoco.rule.bundle.branch.ratio>1</jacoco.rule.bundle.branch.ratio>
        <jacoco.rule.bundle.line.ratio>0.80</jacoco.rule.bundle.line.ratio>
        <jacoco.rule.class.line.ratio>0.80</jacoco.rule.class.line.ratio>
        <jacoco.rule.class.method.ratio>0.80</jacoco.rule.class.method.ratio>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-test-agents</id>
                <phase>generate-test-resources</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>net.bytebuddy</groupId>
                      <artifactId>byte-buddy-agent</artifactId>
                      <version>${byte-buddy.version}</version>
                      <type>jar</type>
                      <outputDirectory>${project.build.directory}/agents</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.mockito</groupId>
                      <artifactId>mockito-core</artifactId>
                      <version>${mockito.version}</version>
                      <type>jar</type>
                      <outputDirectory>${project.build.directory}/agents</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>
                @{argLine}
                @{surefire.argLine}
                --enable-preview
                -javaagent:${project.build.directory}/agents/byte-buddy-agent-${byte-buddy.version}.jar
                -javaagent:${project.build.directory}/agents/mockito-core-${mockito.version}.jar
              </argLine>
              <includes>
                <include>**/*Tests.java</include>
              </includes>
              <excludes>
                <exclude>**/Abstract*.java</exclude>
                <exclude>**/*IT.java</exclude>
                <exclude>**/*IntegrationTests.java</exclude>
              </excludes>
              <parallel>methods</parallel>
              <threadCount>${threadCount}</threadCount>
              <perCoreThreadCount>false</perCoreThreadCount>
              <useModulePath>false</useModulePath>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>integration-test</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <argLine>
                @{argLine}
                @{failsafe.argLine}
                --enable-preview
                -javaagent:${project.build.directory}/agents/byte-buddy-agent-${byte-buddy.version}.jar
                -javaagent:${project.build.directory}/agents/mockito-core-${mockito.version}.jar
              </argLine>
              <includes>
                <include>**/*IntegrationTests.java</include>
                <include>**/*IT.java</include>
              </includes>
              <excludes>
                <exclude>**/*Tests.java</exclude>
                <exclude>**/Abstract*.java</exclude>
              </excludes>
              <parallel>methods</parallel>
              <threadCount>${threadCount}</threadCount>
              <perCoreThreadCount>false</perCoreThreadCount>
              <useModulePath>false</useModulePath>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <configuration>
              <includes>
                <include>${jacoco.includes}</include>
              </includes>
              <excludes>
                <exclude>${jacoco.excludes}</exclude>
                <exclude>**/*_.class</exclude>
                <exclude>**/*$*.class</exclude>
                <exclude>**/config/**/*.class</exclude>
                <exclude>**/dto/**/*.class</exclude>
                <exclude>**/command/**/*.class</exclude>
                <exclude>**/entity/**/*.class</exclude>
                <exclude>**/*Application.class</exclude>
                <exclude>**/module-info.class</exclude>
              </excludes>
            </configuration>
            <executions>
              <!-- Unit Test Coverage -->
              <execution>
                <id>jacoco-prepare-initialize</id>
                <phase>initialize</phase>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <propertyName>surefire.argLine</propertyName>
                </configuration>
              </execution>
              <!-- Integration Test Coverage -->
              <execution>
                <id>jacoco-prepare-integration-initialize</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>prepare-agent-integration</goal>
                </goals>
                <configuration>
                  <propertyName>failsafe.argLine</propertyName>
                </configuration>
              </execution>
              <!-- Check Coverage Rules -->
              <execution>
                <id>default-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <rules>
                    <!-- The main rule for the entire project -->
                    <rule>
                      <element>BUNDLE</element>
                      <excludes>
                        <exclude>**/utils/**</exclude>
                      </excludes>
                      <limits>
                        <limit>
                          <counter>COMPLEXITY</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${jacoco.rule.bundle.complexity.ratio}</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${jacoco.rule.bundle.branch.ratio}</minimum>
                        </limit>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${jacoco.rule.bundle.line.ratio}</minimum>
                        </limit>
                      </limits>
                    </rule>
                    <!-- Separate rule for Utility classes -->
                    <rule>
                      <element>CLASS</element>
                      <includes>
                        <include>**/utils/**</include>
                      </includes>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${jacoco.rule.class.line.ratio}</minimum>
                        </limit>
                        <limit>
                          <counter>METHOD</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${jacoco.rule.class.method.ratio}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <!-- Generate Reports -->
              <execution>
                <id>jacoco-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                  <goal>report-integration</goal>
                </goals>
                <configuration>
                  <outputDirectory>${jacoco.report.outputDirectory}</outputDirectory>
                  <title>${jacoco.report.title}</title>
                  <footer>${jacoco.report.footer}</footer>
                  <formats>
                    <format>${jacoco.report.formats}</format>
                  </formats>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>major</id>
      <activation>
        <property>
          <name>major</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-release-plugin</artifactId>
            <configuration>
              <autoVersionSubmodules>true</autoVersionSubmodules>
              <tagNameFormat>v@{project.version}</tagNameFormat>
              <useReleaseProfile>false</useReleaseProfile>
              <releaseVersion>${parsedVersion.nextMajorVersion}.0.0</releaseVersion>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>minor</id>
      <activation>
        <property>
          <name>minor</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-release-plugin</artifactId>
            <configuration>
              <autoVersionSubmodules>true</autoVersionSubmodules>
              <tagNameFormat>v@{project.version}</tagNameFormat>
              <useReleaseProfile>false</useReleaseProfile>
              <releaseVersion>${parsedVersion.majorVersion}.${parsedVersion.nextMinorVersion}.0</releaseVersion>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <distributionManagement>
    <repository>
      <id>maven-releases</id>
      <url>https://repository.artanpg.ir/repository/maven-releases/</url>
    </repository>
    <snapshotRepository>
      <id>maven-snapshots</id>
      <url>https://repository.artanpg.ir/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>
</project>
