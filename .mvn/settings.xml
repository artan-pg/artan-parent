<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <servers>
    <server>
      <id>maven-releases</id>
      <username>${env.NEXUS_MAVEN_USERNAME}</username>
      <password>${env.NEXUS_MAVEN_PASSWORD}</password>
    </server>
    <server>
      <id>maven-snapshots</id>
      <username>${env.NEXUS_MAVEN_USERNAME}</username>
      <password>${env.NEXUS_MAVEN_PASSWORD}</password>
    </server>
    <server>
      <id>maven-public</id>
      <username>${env.NEXUS_MAVEN_USERNAME}</username>
      <password>${env.NEXUS_MAVEN_PASSWORD}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>artanpg</id>
      <repositories>
        <repository>
          <id>maven-releases</id>
          <url>https://repository.artanpg.ir/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>daily</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>maven-snapshots</id>
          <url>https://repository.artanpg.ir/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>daily</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  
  <activeProfiles>
    <activeProfile>artanpg</activeProfile>
  </activeProfiles>
</settings>
